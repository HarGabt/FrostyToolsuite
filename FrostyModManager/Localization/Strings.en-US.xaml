    <sys:String x:Key="mm_Tip_OpenFolder">Opens Folder</sys:String>
    <sys:String x:Key="mm_Tip_DeleteFolder">Deletes Folder</sys:String>

    <!-- Prelaunch window -->
    <sys:String x:Key="mm_Btn_ScanGames">Scan for games</sys:String>

