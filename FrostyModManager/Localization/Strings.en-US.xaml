    <FontFamily x:Key="MonoFontFamily">Consolas, Global User Interface</FontFamily>
    <FontFamily x:Key="BrandFontFamily">OCR A Extended, Global User Interface</FontFamily>

    <!-- Right-to-left layout -->
    <sys:Boolean x:Key="IsRightToLeft">false</sys:Boolean>

    <!-- App / Window titles -->
    <sys:String x:Key="mm_AppTitle">Frosty Mod Manager</sys:String>
    <sys:String x:Key="mm_About_Title">About Frosty Mod Manager</sys:String>
    <sys:String x:Key="mm_AddProfile_Title">Add Profile</sys:String>
    <sys:String x:Key="mm_Config_Title">Mod Configuration</sys:String>
    <sys:String x:Key="mm_Collection_Title">Export Collection</sys:String>
    <sys:String x:Key="mm_Errors_Title">Installation Report</sys:String>
    <sys:String x:Key="mm_LaunchOpts_Title">Launch Options</sys:String>
    <sys:String x:Key="mm_ModData_Title">Manage ModData</sys:String>

    <!-- Main menu -->
    <sys:String x:Key="mm_Menu_File">File</sys:String>
    <sys:String x:Key="mm_Menu_Pack">Pack</sys:String>
    <sys:String x:Key="mm_Menu_Tools">Tools</sys:String>
    <sys:String x:Key="mm_Menu_Help">Help</sys:String>
    <sys:String x:Key="mm_Menu_Language">Language</sys:String>

