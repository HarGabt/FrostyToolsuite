    <sys:String x:Key="mm_Msg_AtLeastOnePack">There must be at least one active pack</sys:String>
    <sys:String x:Key="mm_Msg_ConfirmDeletePack">Are you sure you want to delete this pack?</sys:String>
    <sys:String x:Key="mm_Msg_PackExists">A pack with the same name already exists</sys:String>
    <sys:String x:Key="mm_Msg_ModsUninstalled">Mod(s) has been successfully uninstalled</sys:String>
