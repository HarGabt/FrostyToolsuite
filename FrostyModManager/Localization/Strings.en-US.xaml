    <sys:String x:Key="mm_Tip_RemoveMod">Remove mod from list</sys:String>

    <!-- Resources (conflicts) tab -->
    <sys:String x:Key="mm_Chk_ShowConflicts">Show conflicts only</sys:String>

    <!-- About window -->
    <sys:String x:Key="mm_About_Copyright">Copyright© 2017-2020</sys:String>
    <sys:String x:Key="mm_About_Authors">derwangler, Cade and benji</sys:String>
    <sys:String x:Key="mm_About_OriginalCreator">Originally created by GalaxyMan2015</sys:String>
    <sys:String x:Key="mm_About_Website">Website: </sys:String>
    <sys:String x:Key="mm_About_Support">Support: </sys:String>

    <!-- Add Profile window -->
    <sys:String x:Key="mm_AddProfile_NameLabel">Profile Name:</sys:String>

    <!-- Collection Settings window labels -->
    <sys:String x:Key="mm_Label_Title">Title </sys:String>
    <sys:String x:Key="mm_Label_Author">Author </sys:String>
    <sys:String x:Key="mm_Label_Version">Version </sys:String>
    <sys:String x:Key="mm_Label_Category">Category </sys:String>
    <sys:String x:Key="mm_Label_Link">Link </sys:String>

    <!-- Launch Options window -->
    <sys:String x:Key="mm_LaunchOpts_CmdArgs">Command Line Arguments:</sys:String>

