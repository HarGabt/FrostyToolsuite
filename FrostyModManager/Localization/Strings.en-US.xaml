                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Frosty Mod Manager — English (en-US) -->

    <!-- Dynamic fonts (override per language) -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable Text, Global User Interface</FontFamily>
