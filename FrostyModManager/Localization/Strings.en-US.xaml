    <sys:String x:Key="mm_Btn_Close">Close</sys:String>
    <sys:String x:Key="mm_Btn_Add">Add</sys:String>
    <sys:String x:Key="mm_Btn_New">New</sys:String>
    <sys:String x:Key="mm_Btn_Remove">Remove</sys:String>
    <sys:String x:Key="mm_Btn_Select">Select</sys:String>

</ResourceDictionary>
