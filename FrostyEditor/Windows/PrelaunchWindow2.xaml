<ctrl:FrostyDockableWindow x:Class="FrostyEditor.Windows.PrelaunchWindow2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:FrostyEditor.Windows"
                           xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
                           Icon="/FrostyCore;component/AppIcon.ico"
                           mc:Ignorable="d"
                           Title="{DynamicResource fe_Prelaunch_Title}" Height="250" Width="400" Loaded="Window_Loaded"
                           ResizeMode="NoResize" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource ListBackground}">
            <StackPanel x:Name="GameInfoStackPanel" Margin="8">
                <TextBlock x:Name="ProfileNameTextBlock" Foreground="{StaticResource FontColor}" FontSize="14" FontWeight="Medium"/>
                <TextBlock x:Name="ProfilePathTextBlock" Foreground="{StaticResource FontColor}" FontSize="10"/>
            </StackPanel>
            <TextBlock x:Name="SelectGameTextBlock" Text="{DynamicResource fe_Prelaunch_SelectGame}" Foreground="{StaticResource FontColor}" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ControlBackground}"/>

        <Grid Grid.Row="2">
            <ListBox x:Name="ConfigurationListView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ConfigurationListView_OnSelectionChanged" MouseDoubleClick="ConfigurationListView_OnMouseDoubleClick" Background="{StaticResource WindowBackground}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="true" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="40"
                              Height="40">
                            <Image x:Name="ColorImage"
                                   Source="{Binding Path=Thumbnail}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource ListBackground}" >
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="AddConfigurationButton" Content="{DynamicResource fe_Btn_Add}" Padding="12,0" Margin="6,6,0,6" Click="AddConfigurationButton_OnClick"/>
                <Button x:Name="RemoveConfigurationButton" Content="{DynamicResource fe_Btn_Remove}" Padding="12,0" Margin="6,6,0,6" Click="RemoveConfigurationButton_OnClick"/>
                <Button x:Name="LaunchConfigurationButton" Content="{DynamicResource fe_Btn_Select}" Padding="12,0" Margin="6,6,6,6" Click="LaunchConfigurationButton_OnClick"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{DynamicResource fe_Btn_Cancel}" Padding="12,0" Margin="6,6,0,6" Click="CancelButton_OnClick"/>
                <Button x:Name="ScanButton" Content="{DynamicResource fe_Btn_Scan}" Padding="12,0" Margin="6,6,0,6" Click="ScanButton_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</ctrl:FrostyDockableWindow>
